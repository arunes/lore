<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enables additional static code analysis for EF Core best practices -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lore.Core/Lore.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RapidOcrModelDir>$(NuGetPackageRoot)rapidocrnet/3.0.0/models/v5/</RapidOcrModelDir>
  </PropertyGroup>

  <Target Name="CopyRapidOcrModels" AfterTargets="Build" Condition="Exists('$(RapidOcrModelDir)')">
    <ItemGroup>
      <_RapidOcrModelFiles Include="$(RapidOcrModelDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RapidOcrModelFiles)" DestinationFolder="$(TargetDir)models/v5/" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRapidOcrModelsPublish" AfterTargets="Publish" Condition="Exists('$(RapidOcrModelDir)')">
    <ItemGroup>
      <_RapidOcrModelPublishFiles Include="$(RapidOcrModelDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RapidOcrModelPublishFiles)" DestinationFolder="$(PublishDir)models/v5/" SkipUnchangedFiles="true" />
  </Target>
</Project>
